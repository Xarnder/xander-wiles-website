{
    "version": 2,
    "framework": null,
    "buildCommand": "node build.js",
    "outputDirectory": "deploy_out",
    "rewrites": [
        {
            "source": "/pages/Routine",
            "destination": "/pages/Routine/index.html"
        },
        {
            "source": "/pages/Routine/:path*",
            "destination": "/pages/Routine/200.html"
        },
        {
            "source": "/pages/journal/:path*",
            "destination": "/pages/journal/index.html"
        },
        {
            "source": "/pages/Group-Availability/event",
            "destination": "/pages/Group-Availability/event.html"
        },
        {
            "source": "/pages/Group-Availability/auth-callback",
            "destination": "/pages/Group-Availability/auth-callback.html"
        }
    ],
    "cleanUrls": true
}
