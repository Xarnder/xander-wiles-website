{
	"name": "tax-helper",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/papaparse": "^5.5.2",
		"svelte": "^5.57.1",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"vite": "^8.3.0",
		"deepmerge": "file:../../vendor/deepmerge"
	},
	"dependencies": {
		"@lucide/svelte": "^1.17.0",
		"ofx-data-extractor": "^1.5.0",
		"papaparse": "^5.5.3"
	},
	"overrides": {
		"deepmerge": "$deepmerge"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
