{
    "name": "functions",
    "description": "Cloud Functions for Firebase",
    "scripts": {
        "serve": "firebase emulators:start --only functions",
        "shell": "firebase functions:shell",
        "start": "npm run shell",
        "deploy": "firebase deploy --only functions",
        "logs": "firebase functions:log",
        "test": "node --test index.test.js"
    },
    "engines": {
        "node": "22"
    },
    "main": "index.js",
    "dependencies": {
        "firebase-admin": "^13.0.0",
        "firebase-functions": "^7.4.0",
        "@google-cloud/monitoring": "^6.2.0"
    },
    "devDependencies": {
        "firebase-functions-test": "^3.5.0",
        "deepmerge": "file:../../../vendor/deepmerge",
        "minimatch": "file:../../../vendor/minimatch-compat",
        "jest": "^30.2.0"
    },
    "private": true,
    "overrides": {
        "deepmerge": "$deepmerge",
        "minimatch": "$minimatch",
        "glob": "^14.0.3",
        "uuid": "^11.1.1",
        "@grpc/grpc-js": "^1.14.7",
        "ts-deepmerge": "^8.0.0"
    }
}
