rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidTimestamp(value) {
      return value is number && value > 0;
    }

    function isValidTimeRange(data) {
      return isValidTimestamp(data.startTime)
        && isValidTimestamp(data.endTime)
        && data.endTime > data.startTime
        && data.durationMs is number
        && data.durationMs > 0;
    }

    function isValidWorkSession() {
      return isValidTimeRange(request.resource.data)
        && request.resource.data.rate is number
        && request.resource.data.rate >= 0
        && request.resource.data.earnings is number
        && request.resource.data.earnings >= 0
        && (!('company' in request.resource.data)
            || request.resource.data.company is string)
        && (!('project' in request.resource.data)
            || request.resource.data.project is string)
        && (!('focused' in request.resource.data)
            || request.resource.data.focused is bool);
    }

    function isValidBreak() {
      return isValidTimeRange(request.resource.data)
        && (!('label' in request.resource.data) || request.resource.data.label is string);
    }

    function isValidTimeCostItem() {
      return request.resource.data.name is string
        && request.resource.data.cost is number
        && request.resource.data.cost >= 0
        && (!('dateBought' in request.resource.data)
            || request.resource.data.dateBought == null
            || request.resource.data.dateBought is string)
        && (!('savedAmount' in request.resource.data)
            || (request.resource.data.savedAmount is number
                && request.resource.data.savedAmount >= 0
                && request.resource.data.savedAmount <= request.resource.data.cost));
    }

    function isValidPayScale(scale) {
      return scale == 'hour'
        || scale == 'day'
        || scale == 'week'
        || scale == 'month'
        || scale == 'year';
    }

    function isValidPayPeriod() {
      return request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && isValidPayScale(request.resource.data.scale)
        && request.resource.data.startDate is string
        && request.resource.data.startDate.size() == 10
        && (!('endDate' in request.resource.data)
            || request.resource.data.endDate == null
            || (request.resource.data.endDate is string
                && request.resource.data.endDate.size() == 10))
        && (!('company' in request.resource.data) || request.resource.data.company is string)
        && (!('name' in request.resource.data) || request.resource.data.name is string)
        && (!('dailyHours' in request.resource.data)
            || (request.resource.data.dailyHours is number
                && request.resource.data.dailyHours > 0))
        && (!('workingDaysPerWeek' in request.resource.data)
            || (request.resource.data.workingDaysPerWeek is number
                && request.resource.data.workingDaysPerWeek >= 1
                && request.resource.data.workingDaysPerWeek <= 7));
    }

    function isValidBudgetingSettings() {
      return request.resource.data.totalAmount is number
        && request.resource.data.totalAmount >= 0
        && request.resource.data.divisions is list
        && request.resource.data.divisions.size() >= 1
        && request.resource.data.divisions.size() <= 16;
    }

    match /users/{userId} {

      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidWorkSession();
        allow delete: if isOwner(userId);
      }

      match /breaks/{breakId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidBreak();
        allow delete: if isOwner(userId);
      }

      match /timeCostItems/{itemId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidTimeCostItem();
        allow delete: if isOwner(userId);
      }

      match /payPeriods/{payPeriodId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidPayPeriod();
        allow delete: if isOwner(userId);
      }

      match /settings/{settingId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && (
          settingId != 'budgeting' || isValidBudgetingSettings()
        );
      }
    }
  }
}
