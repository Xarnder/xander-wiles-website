# E2E / Playwright mode uses an in-memory repository (no Firebase).
PUBLIC_ROUTINE_E2E=

# Firebase web config for project routine-manager-xander (or your chosen ID)
PUBLIC_ROUTINE_FIREBASE_API_KEY=
PUBLIC_ROUTINE_FIREBASE_AUTH_DOMAIN=
PUBLIC_ROUTINE_FIREBASE_PROJECT_ID=
PUBLIC_ROUTINE_FIREBASE_STORAGE_BUCKET=
PUBLIC_ROUTINE_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_ROUTINE_FIREBASE_APP_ID=
