{
    "rewrites": [
        {
            "source": "/pages/Routine",
            "destination": "/pages/Routine/index.html"
        },
        {
            "source": "/pages/Routine/:path*",
            "destination": "/pages/Routine/200.html"
        },
        {
            "source": "/pages/journal/:path*",
            "destination": "/pages/journal/index.html"
        }
    ],
    "cleanUrls": true,
    "headers": [
        {
            "source": "pages/Silence-Cutter/**",
            "headers": [
                {
                    "key": "Cross-Origin-Opener-Policy",
                    "value": "same-origin"
                },
                {
                    "key": "Cross-Origin-Embedder-Policy",
                    "value": "require-corp"
                },
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; connect-src 'self' blob: data: https://huggingface.co https://*.huggingface.co https://*.hf.co; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; object-src 'none'; frame-src 'none'; form-action 'none'; base-uri 'self'"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "no-referrer"
                }
            ]
        },
        {
            "source": "**",
            "headers": [
                {
                    "key": "Permissions-Policy",
                    "value": "xr-spatial-tracking=*"
                }
            ]
        }
    ]
}
